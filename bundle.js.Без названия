// Full game block handler
document.addEventListener('DOMContentLoaded', function () {
  const promoPanel = document.querySelector('.promopanel');

  if (promoPanel) {
    promoPanel.style.display = 'none';
    const showPoint = window.innerHeight * 0.5;

    const handleScroll = () => {
      promoPanel.style.display =
        (window.pageYOffset || document.documentElement.scrollTop) >= showPoint ? 'block' : 'none';
    };

    window.addEventListener('scroll', handleScroll);

    const closeBtn = promoPanel.querySelector('.promopanel__close');
    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        promoPanel.style.display = 'none';
        window.removeEventListener('scroll', handleScroll);
      });
    }
  }

  const bgImg = document.querySelector('.bg-image');
  if (bgImg && window.innerWidth < 768) {
    bgImg.style.backgroundImage = `url('${bgImg.getAttribute('data-mobile-image')}')`;
  }

  const playBtn = document.querySelector('.play-btn');
  if (!playBtn) return;

  function handleDesktop() {
    const bg = document.querySelector('.bg-image');
    const iframeContainer = document.querySelector('.iframe');
    const iframe = document.querySelector('.iframe-game');
    const box = document.querySelector('.box');

    if (!bg || !iframeContainer || !iframe || !box) {
      openRefLink();
      return;
    }

    bg.classList.add('hide');
    box.classList.add('hide');
    iframeContainer.classList.add('show');

    const url = iframe.getAttribute('data-src');
    if (url) iframe.setAttribute('src', url);
  }

  function openRefLink() {
    const refBtn = document.querySelector('.btn-yellow');
    if (!refBtn) return;
    const hasRefAttr = Array.from(refBtn.attributes).some((a) => a.name.startsWith('data-v-'));
    if (!hasRefAttr) return;

    /* eslint-disable-next-line no-undef -- substituted at HTML build time */
    const REF_PATH = "/jump";
    const refPathBase = String(REF_PATH || '').replace(/\/+$/, '');
    const targetUrl = refPathBase ? `${refPathBase}/` : '/';
    window.open(targetUrl, '_blank');
  }

  function handleMobile() {
    const modal = document.querySelector('.game-modal');
    if (!modal) {
      openRefLink();
      return;
    }

    const iframe = modal.querySelector('iframe');
    const url = iframe.getAttribute('data-src');
    if (url) iframe.setAttribute('src', url);
    modal.classList.add('active');
  }

  playBtn.addEventListener('click', () => (window.innerWidth <= 768 ? handleMobile() : handleDesktop()));

  const closeBtn = document.querySelector('.close-btn');
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      const modal = document.querySelector('.game-modal');
      const iframe = modal.querySelector('iframe');
      modal.classList.remove('active');
      iframe.setAttribute('src', '');
    });
  }
});
