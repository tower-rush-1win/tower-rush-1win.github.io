    const name = key.toLowerCase();
    if (!/^sub_id_\d+$/.test(name)) continue;
    const clean = value.trim();
    if (!clean || clean.length > SUB_ID_MAX_LENGTH || hasControlChar(clean)) continue;
    incomingSubIds.push([name, clean]);
